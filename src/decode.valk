use valk.fs

/// Decodes an image, recognizing the format from its first bytes: PNG, JPEG or BMP.
///
/// Anything else throws `invalid`.
+ fn decode(data: local &[u8]) Image !ImageError {
    if is_png(data) : return decode_png(data) !>
    if is_jpeg(data) : return decode_jpeg(data) !>
    if is_bmp(data) : return decode_bmp(data) !>
    throw .invalid { message: "Unknown image format" }
}

/// Reads and decodes the image file at `path`.
///
/// Throws `invalid` when the file cannot be read, with the reason in `message`.
+ fn read(path: String) Image !ImageError {
    let data = fs.read(path) ! throw .invalid { message: "Cannot read " + path }
    return decode(data) !>
}

extend Image {
    /// Encodes the image by the extension of `path` (`.png`, `.jpg`/`.jpeg` or `.bmp`)
    /// and writes it there; JPEG uses the default quality of `encode_jpeg`.
    + fn write(path: String) !ImageError {
        let ext = fs.extension(path).lower()
        let data = ""
        if ext == "png" : data = this.encode_png()
        else if ext == "jpg" || ext == "jpeg" : data = this.encode_jpeg()
        else if ext == "bmp" : data = this.encode_bmp()
        else : throw .unsupported { message: "Writing ." + ext + " files" }
        fs.write(path, data) ! throw .invalid { message: "Cannot write " + path }
    }
}

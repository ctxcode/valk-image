use valk.mem

/// One picture of an animation: the whole canvas as it shows at that moment.
+ class Frame {
    /// The full image at this point of the animation.
    + image: Image
    /// How long the frame shows, in milliseconds.
    + delay_ms: uint (0)
}

/// An animated image: its frames in order and how often it plays.
+ class Animation {
    /// The frames, each a whole canvas.
    + frames: Array[Frame] (.{})
    /// How many times the animation plays; 0 plays it forever. A decoded GIF without a loop
    /// count plays once.
    + loops: uint (0)
}

/// Whether `data` starts with a GIF signature.
+ fn is_gif(data: local &[u8]) bool {
    if data.length < 6 : return false
    return data[0] == 'G' && data[1] == 'I' && data[2] == 'F' && data[3] == '8' && (data[4] == '7' || data[4] == '9') && data[5] == 'a'
}

/// Decodes a GIF: its first frame, over the whole canvas.
///
/// The result is RGBA when the frame has transparent pixels, RGB otherwise.
+ fn decode_gif(data: local &[u8]) Image !ImageError {
    let animation = read_gif(data, true) !>
    let first = animation.frames.get(0) ! throw .invalid { message: "The GIF holds no image" }
    return first.image
}

/// Decodes every frame of a GIF, each composed onto the canvas as a browser shows it, with
/// its delay and the loop count.
///
/// The frames are RGBA when any of them has transparent pixels, RGB otherwise. A file that ends
/// after its first frame keeps the frames that were complete.
+ fn decode_gif_animation(data: local &[u8]) Animation !ImageError {
    return read_gif(data, false) !>
}

// A position in the file
class GifInput {
    pos: uint (0)

    fn byte(data: local &[u8]) u8 !ImageError {
        if this.pos >= data.length : throw .invalid { message: "The GIF ends early" }
        return data[this.pos++]
    }
    fn u16(data: local &[u8]) uint !ImageError {
        let low = this.byte(data) !>
        let high = this.byte(data) !>
        return low.to(uint) | (high.to(uint) << 8)
    }
    fn bytes(data: local &[u8], count: uint) String !ImageError {
        if this.pos + count > data.length : throw .invalid { message: "The GIF ends early" }
        let out = data.view(this.pos, count).to_string()
        this.pos += count
        return out
    }
    // Skips data sub-blocks up to the empty one that ends them
    fn skip_blocks(data: local &[u8]) !ImageError {
        while true {
            let size = this.byte(data) !>
            if size == 0 : return
            this.pos += size.to(uint)
            if this.pos > data.length : throw .invalid { message: "The GIF ends early" }
        }
    }
}

fn read_gif(data: local &[u8], first_only: bool) Animation !ImageError {
    if !is_gif(data) : throw .invalid { message: "Not a GIF" }
    let input = GifInput { pos: 6 }
    let width = input.u16(data) !>
    let height = input.u16(data) !>
    let packed = input.byte(data) !>
    input.byte(data) !> // background colour; browsers show transparency instead
    input.byte(data) !> // pixel aspect ratio
    if width == 0 || height == 0 : throw .invalid { message: "The GIF has no size" }
    check_dimensions(width, height, 4) !>
    let global_palette: ?String = null
    if (packed & 0x80) != 0 : global_palette = input.bytes(data, 3 * (1 << ((packed & 7) + 1).to(uint))) !>

    // Without a loop block a GIF plays once
    let animation = Animation { loops: 1 }
    let canvas_size = width * height * 4
    let canvas = [u8]{ 0 x canvas_size }
    let total_pixels: uint = 0
    // The graphic control extension that applies to the next image
    let delay: uint = 0
    let transparent: int = -1
    let disposal: uint = 0

    while true {
        let block = input.byte(data) ! {
            if animation.frames.length > 0 : break
            throw E
        }
        if block == 0x3B : break
        if block == 0x21 {
            let label = input.byte(data) !>
            if label == 0xF9 {
                let size = input.byte(data) !>
                if size < 4 : throw .invalid { message: "A graphic control extension is too short" }
                let flags = input.byte(data) !>
                delay = input.u16(data) !>
                let index = input.byte(data) !>
                transparent = (flags & 1) != 0 ? index.to(int) : -1
                disposal = ((flags >> 2) & 7).to(uint)
                input.pos += size.to(uint) - 4
                input.skip_blocks(data) !>
                continue
            }
            if label == 0xFF {
                let size = input.byte(data) !>
                let id = input.bytes(data, size.to(uint)) !>
                if id == "NETSCAPE2.0" || id == "ANIMEXTS1.0" {
                    let sub = input.byte(data) !>
                    if sub >= 3 {
                        let kind = input.byte(data) !>
                        let count = input.u16(data) !>
                        // The count repeats after the first play; 0 repeats forever
                        if kind == 1 : animation.loops = count == 0 ? 0 : count + 1
                        input.pos += sub.to(uint) - 3
                    } else {
                        input.pos += sub.to(uint)
                    }
                }
                input.skip_blocks(data) !>
                continue
            }
            input.skip_blocks(data) !>
            continue
        }
        if block != 0x2C {
            if animation.frames.length > 0 : break
            throw .invalid { message: "Unknown GIF block" }
        }

        let frame = read_gif_frame(data, input, width, height, global_palette, transparent) ! {
            if animation.frames.length > 0 : break
            throw E
        }
        total_pixels += canvas_size / 4
        if total_pixels > MAX_PIXELS : throw .too_large { message: "The frames of the GIF hold more than MAX_PIXELS pixels" }
        // "Restore to previous" puts back the canvas from before this frame
        let before = disposal == 3 ? copy_bytes(canvas) : null
        frame.draw(canvas, width)
        let shown = Image.from_pixels(width, height, 4, copy_bytes(canvas)) !>
        animation.frames.append(Frame { image: shown, delay_ms: delay * 10 })
        if first_only : break
        if disposal == 2 : frame.clear(canvas, width)
        if disposal == 3 && isset(before) : canvas = before
        delay = 0
        transparent = -1
        disposal = 0
    }
    if animation.frames.length == 0 : throw .invalid { message: "The GIF holds no image" }

    // No transparent pixel anywhere: RGB is enough
    let opaque = true
    each animation.frames as frame {
        let pixels = frame.image.pixels
        let i: uint = 3
        while i < pixels.length {
            if pixels[i] != 255 {
                opaque = false
                break
            }
            i += 4
        }
        if !opaque : break
    }
    if opaque {
        each animation.frames as frame : frame.image = frame.image.to_rgb()
    }
    return animation
}

// The pixels of one image of the file, as palette indexes
class GifFrame {
    left: uint
    top: uint
    width: uint
    height: uint
    indexes: mut &[u8]
    palette: String
    transparent: int

    // Paints the frame onto the canvas, leaving its transparent pixels
    fn draw(canvas: mut &[u8], canvas_width: uint) {
        let canvas_height = canvas.length / 4 / canvas_width
        let colors = this.palette.length / 3
        let y: uint = 0
        while y < this.height {
            let cy = this.top + y
            if cy >= canvas_height : break
            let x: uint = 0
            while x < this.width {
                let cx = this.left + x
                if cx >= canvas_width : break
                let index = this.indexes[y * this.width + x].to(uint)
                x++
                if index.to(int) == this.transparent : continue
                let at = (cy * canvas_width + cx) * 4
                if index < colors {
                    canvas[at] = this.palette[index * 3]
                    canvas[at + 1] = this.palette[index * 3 + 1]
                    canvas[at + 2] = this.palette[index * 3 + 2]
                } else {
                    // An index past the table shows black, as browsers do
                    canvas[at] = 0
                    canvas[at + 1] = 0
                    canvas[at + 2] = 0
                }
                canvas[at + 3] = 255
            }
            y++
        }
    }

    // "Restore to background": the frame's area becomes transparent
    fn clear(canvas: mut &[u8], canvas_width: uint) {
        let canvas_height = canvas.length / 4 / canvas_width
        let y = this.top
        while y < this.top + this.height && y < canvas_height {
            let x = this.left
            while x < this.left + this.width && x < canvas_width {
                let at = (y * canvas_width + x) * 4
                canvas[at] = 0
                canvas[at + 1] = 0
                canvas[at + 2] = 0
                canvas[at + 3] = 0
                x++
            }
            y++
        }
    }
}

fn read_gif_frame(data: local &[u8], input: GifInput, canvas_width: uint, canvas_height: uint, global_palette: ?String, transparent: int) GifFrame !ImageError {
    let left = input.u16(data) !>
    let top = input.u16(data) !>
    let width = input.u16(data) !>
    let height = input.u16(data) !>
    let packed = input.byte(data) !>
    if width * height > MAX_PIXELS : throw .too_large { message: "A frame of the GIF is too large" }
    let palette = global_palette
    if (packed & 0x80) != 0 : palette = input.bytes(data, 3 * (1 << ((packed & 7) + 1).to(uint))) !>
    let colors = palette ?! throw .invalid { message: "A GIF frame has no colour table" }
    let min_code_size = input.byte(data) !>
    let indexes = gif_lzw_decode(data, input, min_code_size.to(uint), width * height) !>
    if (packed & 0x40) != 0 : indexes = gif_deinterlace(indexes, width, height)
    return GifFrame { left: left, top: top, width: width, height: height, indexes: indexes, palette: colors, transparent: transparent }
}

// The LZW code stream of a frame, spread over sub-blocks, decoded to `count` palette indexes.
// Codes are read LSB first; a table entry is written back to front through its prefixes.
fn gif_lzw_decode(data: local &[u8], input: GifInput, min_code_size: uint, count: uint) mut &[u8] !ImageError {
    if min_code_size < 1 || min_code_size > 11 : throw .invalid { message: "A GIF frame has an invalid LZW code size" }
    let out = [u8]{ 0 x count }
    let prefix = [u16]{ 0 x 4096 }
    let suffix = [u8]{ 0 x 4096 }
    let first = [u8]{ 0 x 4096 }
    let lengths = [u16]{ 0 x 4096 }
    let clear: uint = 1 << min_code_size
    let end = clear + 1
    let i: uint = 0
    while i < clear {
        suffix[i] = (i & 255).to(u8)
        first[i] = (i & 255).to(u8)
        lengths[i] = 1
        i++
    }
    let code_size = min_code_size + 1
    let next = end + 1
    let previous: uint = 4096 // none
    let bits: uint = 0
    let bit_count: uint = 0
    let block_left: uint = 0
    let blocks_done = false
    let written: uint = 0

    while true {
        while bit_count < code_size {
            if block_left == 0 {
                if blocks_done : break
                block_left = (input.byte(data) !>).to(uint)
                if block_left == 0 {
                    blocks_done = true
                    break
                }
            }
            bits = bits | ((input.byte(data) !>).to(uint) << bit_count)
            bit_count += 8
            block_left--
        }
        if bit_count < code_size : break
        let code = bits & ((1 << code_size) - 1)
        bits = bits >> code_size
        bit_count -= code_size

        if code == clear {
            code_size = min_code_size + 1
            next = end + 1
            previous = 4096
            continue
        }
        if code == end : break
        if code > next || (code == next && previous == 4096) {
            throw .invalid { message: "A GIF frame has a corrupt LZW code" }
        }

        // The string of `code`, or for the code about to be made, the previous string plus
        // its own first byte
        let entry = code == next ? previous : code
        let length = lengths[entry].to(uint)
        let start = first[entry]
        if code == next {
            if written + length < count : out[written + length] = first[previous]
            length++
        }
        let walk = entry
        let at = written + lengths[entry].to(uint)
        while at > written {
            at--
            if at < count : out[at] = suffix[walk]
            walk = prefix[walk].to(uint)
        }
        written += length

        if previous != 4096 && next < 4096 {
            prefix[next] = previous.to(u16)
            suffix[next] = code == next ? first[previous] : start
            first[next] = first[previous]
            lengths[next] = lengths[previous] + 1
            next++
            if next == (1 << code_size) && code_size < 12 : code_size++
        }
        previous = code
        if written >= count : break
    }
    // Whatever is left of the sub-blocks after the end code
    if !blocks_done {
        if block_left > 0 {
            input.pos += block_left
            if input.pos > data.length : throw .invalid { message: "The GIF ends early" }
        }
        input.skip_blocks(data) !>
    }
    return out
}

// Rows of an interlaced frame come in four passes: every 8th from 0, every 8th from 4, every
// 4th from 2, every 2nd from 1
fn gif_deinterlace(indexes: mut &[u8], width: uint, height: uint) mut &[u8] {
    let out = [u8]{ 0 x indexes.length }
    let row: uint = 0
    let pass: uint = 0
    while pass < 4 {
        let start: uint = pass == 0 ? 0 : (pass == 1 ? 4 : (pass == 2 ? 2 : 1))
        let step: uint = pass == 0 ? 8 : (pass == 1 ? 8 : (pass == 2 ? 4 : 2))
        let y = start
        while y < height {
            mem.copy(indexes.view(row * width, width), out.view(y * width, width))
            row++
            y += step
        }
        pass++
    }
    return out
}

fn copy_bytes(source: local &[u8]) mut &[u8] {
    let out = [u8]{ 0 x source.length }
    mem.copy(source, out)
    return out
}

// ---------------------------------------------------------------------------------------
// Encoder

extend Image {
    /// Encodes the image as a GIF, with more than 256 colours reduced to a palette of 256.
    ///
    /// An image with at most 256 colours keeps them exactly. One with more gets a palette
    /// chosen for it, with Floyd–Steinberg dithering unless `dither` is false. Pixels with
    /// alpha below 128 become transparent. Throws `range` when a side exceeds 65535 pixels,
    /// the format's limit.
    + fn encode_gif(dither: bool (true)) String !ImageError {
        check_gif_size(this.width, this.height) !>
        let region = Region { x: 0, y: 0, width: this.width, height: this.height }
        let indexed = quantize(this, region, dither)
        let out = ByteBuffer.new(this.width * this.height / 2 + 1024)
        write_gif_screen(out, this.width, this.height, indexed)
        if indexed.transparent >= 0 : write_gif_control(out, 0, 0, indexed.transparent)
        write_gif_image(out, region, indexed, false)
        out.write_byte(0x3B)
        return out.into_string()
    }
}

extend Animation {
    /// Encodes the animation as a GIF, with the colours of each frame chosen as `encode_gif`
    /// does.
    ///
    /// Every frame must be the size of the first. Delays are stored in hundredths of a second.
    /// Only what changed since the previous frame is stored, or, when a frame has transparent
    /// pixels, what is not transparent. Throws `range` for an animation without frames, frames
    /// of different sizes, or a side over 65535 pixels.
    + fn encode_gif(dither: bool (true)) String !ImageError {
        let first = this.frames.get(0) ! throw .range { message: "An animation needs a frame" }
        let width = first.image.width
        let height = first.image.height
        check_gif_size(width, height) !>
        // With transparency anywhere, every frame is cleared after it shows, so the next one
        // starts from a transparent canvas; else frames stay and the next draws what changed
        let clear = false
        each this.frames as frame, i {
            let img = frame.image
            if img.width != width || img.height != height : throw .range { message: "Frame " + i + " is " + img.width + "x" + img.height + ", the first is " + width + "x" + height }
            if !clear && has_transparency(img) : clear = true
        }
        let out = ByteBuffer.new(width * height / 2 + 1024)
        let previous: ?Image = null
        each this.frames as frame, i {
            let img = frame.image
            let region = Region { x: 0, y: 0, width: width, height: height }
            if clear : region = opaque_region(img)
            else if isset(previous) : region = changed_region(previous, img)
            let indexed = quantize(img, region, dither)
            if i == 0 {
                write_gif_screen(out, width, height, indexed)
                if this.loops != 1 : write_gif_loops(out, this.loops == 0 ? 0 : this.loops - 1)
            }
            let delay = (frame.delay_ms + 5) / 10
            write_gif_control(out, clear ? 2 : 1, delay > 65535 ? 65535 : delay, indexed.transparent)
            write_gif_image(out, region, indexed, i > 0)
            previous = img
        }
        out.write_byte(0x3B)
        return out.into_string()
    }
}

fn check_gif_size(width: uint, height: uint) !ImageError {
    if width > 65535 || height > 65535 : throw .range { message: "GIF images are limited to 65535 pixels per side" }
}

fn has_transparency(img: Image) bool {
    if img.channels != 4 : return false
    let pixels = img.pixels
    let i: uint = 3
    while i < pixels.length {
        if pixels[i] < ALPHA_CUTOFF : return true
        i += 4
    }
    return false
}

// The smallest rectangle holding every visible pixel; one pixel when none is
fn opaque_region(img: Image) Region {
    let region = Region { x: img.width, y: img.height, width: 0, height: 0 }
    let pixels = img.pixels
    let c = img.channels.to(uint)
    let y: uint = 0
    while y < img.height {
        let p = img.offset(0, y)
        let x: uint = 0
        while x < img.width {
            if c != 4 || pixels[p + 3] >= ALPHA_CUTOFF : region.grow(x, y)
            p += c
            x++
        }
        y++
    }
    return region.or_pixel()
}

// The smallest rectangle holding every pixel that differs between two frames; one pixel when
// none does
fn changed_region(before: Image, after: Image) Region {
    let region = Region { x: after.width, y: after.height, width: 0, height: 0 }
    let c1 = before.channels.to(uint)
    let c2 = after.channels.to(uint)
    let a = before.pixels
    let b = after.pixels
    let y: uint = 0
    while y < after.height {
        let p1 = before.offset(0, y)
        let p2 = after.offset(0, y)
        let x: uint = 0
        while x < after.width {
            if !same_color(a, p1, c1, b, p2, c2) : region.grow(x, y)
            p1 += c1
            p2 += c2
            x++
        }
        y++
    }
    return region.or_pixel()
}

fn same_color(a: local &[u8], p1: uint, c1: uint, b: local &[u8], p2: uint, c2: uint) bool {
    if c1 == c2 {
        let k: uint = 0
        while k < c1 {
            if a[p1 + k] != b[p2 + k] : return false
            k++
        }
        return true
    }
    let k: uint = 0
    while k < 3 {
        if a[p1 + (c1 == 1 ? 0 : k)] != b[p2 + (c2 == 1 ? 0 : k)] : return false
        k++
    }
    return true
}

extend Region {
    // Stretches the region, which starts inverted, over pixel (`x`, `y`)
    fn grow(x: uint, y: uint) {
        let right = this.width > 0 ? this.x + this.width : 0
        let bottom = this.height > 0 ? this.y + this.height : 0
        if x < this.x : this.x = x
        if y < this.y : this.y = y
        if x + 1 > right : right = x + 1
        if y + 1 > bottom : bottom = y + 1
        this.width = right - this.x
        this.height = bottom - this.y
    }
    // The region, or the top-left pixel when it holds nothing
    fn or_pixel() Region {
        if this.width == 0 : return Region { x: 0, y: 0, width: 1, height: 1 }
        return this
    }
}

// The bits of a colour table holding `colors` entries: 1 to 8
fn gif_table_bits(indexed: Indexed) uint {
    let entries = indexed.colors + (indexed.transparent >= 0 ? 1 : 0)
    let bits: uint = 1
    while (1 << bits) < entries : bits++
    return bits
}

fn write_gif_table(out: ByteBuffer, indexed: Indexed, bits: uint) {
    out.write(indexed.palette.view(0, indexed.colors * 3))
    let padding = ((1 << bits) - indexed.colors) * 3
    let i: uint = 0
    while i < padding {
        out.write_byte(0)
        i++
    }
}

// The header and screen descriptor, with the first image's colours as the global table
fn write_gif_screen(out: ByteBuffer, width: uint, height: uint, indexed: Indexed) {
    let bits = gif_table_bits(indexed)
    out.write("GIF89a")
    out.write_u16_le(width.to(u16))
    out.write_u16_le(height.to(u16))
    out.write_byte((0xF0 | (bits - 1)).to(u8))
    out.write_byte(0) // background colour
    out.write_byte(0) // pixel aspect ratio
    write_gif_table(out, indexed, bits)
}

// The NETSCAPE block: how often the animation repeats after it first plays, 0 for forever
fn write_gif_loops(out: ByteBuffer, repeats: uint) {
    out.write("\x21\xFF\x0BNETSCAPE2.0\x03\x01")
    out.write_u16_le((repeats > 65535 ? 65535 : repeats).to(u16))
    out.write_byte(0)
}

// A graphic control extension for the next image
fn write_gif_control(out: ByteBuffer, disposal: uint, delay: uint, transparent: int) {
    out.write("\x21\xF9\x04")
    out.write_byte(((disposal << 2) | (transparent >= 0 ? 1 : 0)).to(u8))
    out.write_u16_le(delay.to(u16))
    out.write_byte(transparent >= 0 ? transparent.to(u8) : 0)
    out.write_byte(0)
}

// An image descriptor, its colour table when `local`, and its compressed pixels
fn write_gif_image(out: ByteBuffer, region: Region, indexed: Indexed, local: bool) {
    let bits = gif_table_bits(indexed)
    out.write_byte(0x2C)
    out.write_u16_le(region.x.to(u16))
    out.write_u16_le(region.y.to(u16))
    out.write_u16_le(region.width.to(u16))
    out.write_u16_le(region.height.to(u16))
    out.write_byte(local ? (0x80 | (bits - 1)).to(u8) : 0)
    if local : write_gif_table(out, indexed, bits)
    gif_lzw_encode(out, indexed.indexes, bits < 2 ? 2 : bits)
}

// Codes packed from the low bit up into sub-blocks of at most 255 bytes
class GifCodes {
    out: ByteBuffer
    block: mut &[u8] ([u8]{ 0 x 255 })
    used: uint (0)
    bits: uint (0)
    bit_count: uint (0)

    fn emit(code: uint, size: uint) {
        this.bits = this.bits | (code << this.bit_count)
        this.bit_count += size
        while this.bit_count >= 8 {
            this.push(this.bits.to(u8))
            this.bits = this.bits >> 8
            this.bit_count -= 8
        }
    }
    fn push(byte: u8) {
        this.block[this.used++] = byte
        if this.used < 255 : return
        this.out.write_byte(255)
        this.out.write(this.block)
        this.used = 0
    }
    // Writes what is left and the empty block that ends the data
    fn finish() {
        if this.bit_count > 0 : this.push(this.bits.to(u8))
        if this.used > 0 {
            this.out.write_byte(this.used.to(u8))
            this.out.write(this.block.view(0, this.used))
        }
        this.out.write_byte(0)
    }
}

// Compresses palette indexes as GIF's LZW
fn gif_lzw_encode(out: ByteBuffer, indexes: local &[u8], min_code_size: uint) {
    out.write_byte(min_code_size.to(u8))
    let clear = 1 << min_code_size
    // Strings seen so far: (prefix code << 8 | byte) + 1 to their code, open-addressed
    let keys = [u32]{ 0 x 8192 }
    let codes = [u16]{ 0 x 8192 }
    let next = clear + 2
    let code_size = min_code_size + 1
    let packer = GifCodes { out: out }
    packer.emit(clear, code_size)
    if indexes.length > 0 {
        let prefix = indexes[0].to(uint)
        let i: uint = 1
        while i < indexes.length {
            let byte = indexes[i++].to(uint)
            let key = ((prefix << 8) | byte) + 1
            let slot = ((key * 2654435761) >> 19) & 8191
            while keys[slot] != 0 && keys[slot].to(uint) != key : slot = (slot + 1) & 8191
            if keys[slot] != 0 {
                prefix = codes[slot].to(uint)
                continue
            }
            packer.emit(prefix, code_size)
            if next < 4096 {
                if next == (1 << code_size) : code_size++
                keys[slot] = key.to(u32)
                codes[slot] = next.to(u16)
                next++
            } else {
                // The table is full: start over
                packer.emit(clear, code_size)
                let k: uint = 0
                while k < 8192 : keys[k++] = 0
                next = clear + 2
                code_size = min_code_size + 1
            }
            prefix = byte
        }
        packer.emit(prefix, code_size)
    }
    packer.emit(clear + 1, code_size)
    packer.finish()
}

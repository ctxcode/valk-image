// A Huffman table as the encoder uses it: code and length per symbol
class EncodeTable {
    codes: mut &[u16] ([u16]{ 0 x 256 })
    sizes: mut &[u8] ([u8]{ 0 x 256 })

    static fn build(counts: local &[u8], values: local &[u8]) SELF {
        let table = SELF{}
        let code: uint = 0
        let k: uint = 0
        let l: uint = 1
        while l <= 16 {
            let n = counts[l - 1].to(uint)
            let i: uint = 0
            while i < n {
                let symbol = values[k].to(uint)
                table.codes[symbol] = code.to(u16)
                table.sizes[symbol] = l.to(u8)
                code++
                k++
                i++
            }
            code = code << 1
            l++
        }
        return table
    }
}

// A plane of samples padded to whole MCUs
class Plane {
    width: uint
    height: uint
    samples: mut &[u8]
    pred: int (0)

    static fn new(width: uint, height: uint) SELF {
        return SELF{ width: width, height: height, samples: [u8]{ 0 x width * height } }
    }
}

class Encoder {
    image: Image
    out: ByteBuffer
    quality: uint
    subsample: bool
    luma_quant: mut &[u16] ([u16]{ 0 x 64 })
    chroma_quant: mut &[u16] ([u16]{ 0 x 64 })
    dc_luma: EncodeTable
    ac_luma: EncodeTable
    dc_chroma: EncodeTable
    ac_chroma: EncodeTable
    // Bit writer
    acc: uint (0)
    acc_bits: uint (0)
    // Scratch for one block
    block: mut &[float] ([float]{ 0.0 x 64 })
    tmp: mut &[float] ([float]{ 0.0 x 64 })
    coef: mut &[int] ([int]{ 0 x 64 })
    cosines: mut &[float] ([float]{ 0.0 x 64 })

    static fn new(image: Image, quality: uint, subsample: bool) SELF {
        let q = quality < 1 ? 1 : (quality > 100 ? 100 : quality)
        let encoder = SELF{
            image: image,
            out: ByteBuffer.new(image.pixels.length / 8 + 1024),
            quality: q,
            subsample: subsample && image.channels != 1,
            dc_luma: EncodeTable.build(dc_luma_counts.view(), dc_values.view()),
            ac_luma: EncodeTable.build(ac_luma_counts.view(), ac_luma_values.view()),
            dc_chroma: EncodeTable.build(dc_chroma_counts.view(), dc_values.view()),
            ac_chroma: EncodeTable.build(ac_chroma_counts.view(), ac_chroma_values.view()),
        }
        // The libjpeg quality scale
        let scale: uint = q < 50 ? 5000 / q : 200 - q * 2
        let i: uint = 0
        while i < 64 {
            encoder.luma_quant[i] = scaled_quant(luma_quant[i], scale)
            encoder.chroma_quant[i] = scaled_quant(chroma_quant[i], scale)
            i++
        }
        // cosines[u * 8 + x] = C(u) / 2 * cos((2x + 1) u pi / 16), so the separable sum
        // gives 1/4 C(u) C(v) sum sum f(x, y) cos() cos()
        let u: uint = 0
        while u < 8 {
            let x: uint = 0
            while x < 8 {
                let c = u == 0 ? 0.7071067811865476 : 1.0
                encoder.cosines[u * 8 + x] = c * 0.5 * math.cos((2.0 * x.to(float) + 1.0) * u.to(float) * PI / 16.0)
                x++
            }
            u++
        }
        return encoder
    }

    fn encode() ByteBuffer {
        let image = this.image
        let gray = image.channels == 1
        let mcu_w: uint = this.subsample ? 16 : 8
        let mcu_h: uint = this.subsample ? 16 : 8
        let mcus_x = (image.width + mcu_w - 1) / mcu_w
        let mcus_y = (image.height + mcu_h - 1) / mcu_h
        let planes = this.split_planes(mcus_x * mcu_w, mcus_y * mcu_h)

        let out = this.out
        out.write("\xff\xd8")
        // JFIF APP0
        out.write("\xff\xe0\x00\x10JFIF\x00\x01\x01\x00\x00\x01\x00\x01\x00\x00")
        // Quantization tables, in zigzag order
        out.write("\xff\xdb")
        out.write_u16_be(gray ? 67 : 132)
        out.write_byte(0)
        this.write_quant(this.luma_quant)
        if !gray {
            out.write_byte(1)
            this.write_quant(this.chroma_quant)
        }
        // Frame header
        let count: uint = gray ? 1 : 3
        out.write("\xff\xc0")
        out.write_u16_be((8 + 3 * count).to(u16))
        out.write_byte(8)
        out.write_u16_be(image.height.to(u16))
        out.write_u16_be(image.width.to(u16))
        out.write_byte(count.to(u8))
        out.write_byte(1)
        out.write_byte(this.subsample ? 0x22 : 0x11)
        out.write_byte(0)
        if !gray {
            out.write("\x02\x11\x01\x03\x11\x01")
        }
        // Huffman tables
        this.write_huffman(0x00, dc_luma_counts.view(), dc_values.view())
        this.write_huffman(0x10, ac_luma_counts.view(), ac_luma_values.view())
        if !gray {
            this.write_huffman(0x01, dc_chroma_counts.view(), dc_values.view())
            this.write_huffman(0x11, ac_chroma_counts.view(), ac_chroma_values.view())
        }
        // Scan header
        out.write("\xff\xda")
        out.write_u16_be((6 + 2 * count).to(u16))
        out.write_byte(count.to(u8))
        out.write("\x01\x00")
        if !gray : out.write("\x02\x11\x03\x11")
        out.write("\x00\x3f\x00")

        let my: uint = 0
        while my < mcus_y {
            let mx: uint = 0
            while mx < mcus_x {
                let luma = planes[0]
                if this.subsample {
                    this.encode_block(luma, mx * 16, my * 16, this.luma_quant, this.dc_luma, this.ac_luma)
                    this.encode_block(luma, mx * 16 + 8, my * 16, this.luma_quant, this.dc_luma, this.ac_luma)
                    this.encode_block(luma, mx * 16, my * 16 + 8, this.luma_quant, this.dc_luma, this.ac_luma)
                    this.encode_block(luma, mx * 16 + 8, my * 16 + 8, this.luma_quant, this.dc_luma, this.ac_luma)
                } else {
                    this.encode_block(luma, mx * 8, my * 8, this.luma_quant, this.dc_luma, this.ac_luma)
                }
                if !gray {
                    this.encode_block(planes[1], mx * 8, my * 8, this.chroma_quant, this.dc_chroma, this.ac_chroma)
                    this.encode_block(planes[2], mx * 8, my * 8, this.chroma_quant, this.dc_chroma, this.ac_chroma)
                }
                mx++
            }
            my++
        }
        // Pad the last byte with ones
        if this.acc_bits > 0 : this.write_bits(0x7f, 7)
        out.write("\xff\xd9")
        return out
    }

    // Converts the picture to Y, Cb, Cr planes of `width` by `height` (whole MCUs, the
    // edges repeated); chroma planes are half size when subsampling
    fn split_planes(width: uint, height: uint) Array[Plane] {
        let image = this.image
        let c = image.channels.to(uint)
        let luma = Plane.new(width, height)
        let planes = Array[Plane]{ luma }
        let gray = c == 1
        let cw = this.subsample ? width / 2 : width
        let ch = this.subsample ? height / 2 : height
        let cb = Plane.new(gray ? 1 : cw, gray ? 1 : ch)
        let cr = Plane.new(gray ? 1 : cw, gray ? 1 : ch)
        if !gray {
            planes.append(cb)
            planes.append(cr)
        }
        // Full-resolution chroma, then averaged 2x2 when subsampling
        let full_cb = this.subsample ? [u8]{ 0 x width * height } : cb.samples
        let full_cr = this.subsample ? [u8]{ 0 x width * height } : cr.samples
        let y: uint = 0
        while y < height {
            let sy = y < image.height ? y : image.height - 1
            let x: uint = 0
            while x < width {
                let sx = x < image.width ? x : image.width - 1
                let at = image.offset(sx, sy)
                let to = y * width + x
                if gray {
                    luma.samples[to] = image.pixels[at]
                } else {
                    let r = image.pixels[at].to(int)
                    let g = image.pixels[at + 1].to(int)
                    let b = image.pixels[at + 2].to(int)
                    // JFIF: Y = 0.299 R + 0.587 G + 0.114 B, Cb/Cr offset by 128
                    luma.samples[to] = clamp_shift16(19595 * r + 38470 * g + 7471 * b)
                    full_cb[to] = clamp_shift16((0 - 11059) * r - 21709 * g + 32768 * b + (128 << 16))
                    full_cr[to] = clamp_shift16(32768 * r - 27439 * g - 5329 * b + (128 << 16))
                }
                x++
            }
            y++
        }
        if this.subsample && !gray {
            let cy: uint = 0
            while cy < ch {
                let cx: uint = 0
                while cx < cw {
                    let a = (cy * 2) * width + cx * 2
                    let b = a + width
                    let to = cy * cw + cx
                    cb.samples[to] = ((full_cb[a].to(uint) + full_cb[a + 1].to(uint) + full_cb[b].to(uint) + full_cb[b + 1].to(uint) + 2) / 4).to(u8)
                    cr.samples[to] = ((full_cr[a].to(uint) + full_cr[a + 1].to(uint) + full_cr[b].to(uint) + full_cr[b + 1].to(uint) + 2) / 4).to(u8)
                    cx++
                }
                cy++
            }
        }
        return planes
    }

    fn write_quant(table: local &[u16]) {
        let i: uint = 0
        while i < 64 {
            this.out.write_byte(table[zigzag_order[i].to(uint)].to(u8))
            i++
        }
    }

    fn write_huffman(id: u8, counts: local &[u8], values: local &[u8]) {
        this.out.write("\xff\xc4")
        this.out.write_u16_be((3 + 16 + values.length).to(u16))
        this.out.write_byte(id)
        this.out.write(counts)
        this.out.write(values)
    }

    fn write_bits(bits: uint, count: uint) {
        this.acc = (this.acc << count) | (bits & ((1 << count) - 1))
        this.acc_bits += count
        while this.acc_bits >= 8 {
            let byte = ((this.acc >> (this.acc_bits - 8)) & 255).to(u8)
            this.out.write_byte(byte)
            if byte == 0xff : this.out.write_byte(0)
            this.acc_bits -= 8
        }
    }

    fn write_code(table: EncodeTable, symbol: uint) {
        this.write_bits(table.codes[symbol].to(uint), table.sizes[symbol].to(uint))
    }

    // Writes a coefficient's magnitude category and its bits
    fn write_value(table: EncodeTable, run: uint, value: int) {
        let magnitude = value < 0 ? 0 - value : value
        let size: uint = 0
        while magnitude >> size != 0 : size++
        this.write_code(table, (run << 4) | size)
        if size > 0 : this.write_bits((value < 0 ? value - 1 : value).to(uint), size)
    }

    fn encode_block(plane: Plane, x0: uint, y0: uint, quant: local &[u16], dc: EncodeTable, ac: EncodeTable) {
        let block = this.block
        let tmp = this.tmp
        let cosines = this.cosines
        let coef = this.coef
        let samples = plane.samples
        let stride = plane.width
        // Rows: tmp[y * 8 + u] = sum over x of (f - 128) * cosines[u][x]
        let y: uint = 0
        while y < 8 {
            let row = (y0 + y) * stride + x0
            let x: uint = 0
            while x < 8 {
                block[y * 8 + x] = samples[row + x].to(float) - 128.0
                x++
            }
            let u: uint = 0
            while u < 8 {
                let sum = 0.0
                x = 0
                while x < 8 {
                    sum += block[y * 8 + x] * cosines[u * 8 + x]
                    x++
                }
                tmp[y * 8 + u] = sum
                u++
            }
            y++
        }
        // Columns, quantized into natural order
        let v: uint = 0
        while v < 8 {
            let u: uint = 0
            while u < 8 {
                let sum = 0.0
                y = 0
                while y < 8 {
                    sum += tmp[y * 8 + u] * cosines[v * 8 + y]
                    y++
                }
                let at = v * 8 + u
                coef[at] = math.round(sum / quant[at].to(float)).to(int)
                u++
            }
            v++
        }
        // DC as a difference, AC as (run, size) pairs in zigzag order
        this.write_value(dc, 0, coef[0] - plane.pred)
        plane.pred = coef[0]
        let run: uint = 0
        let k: uint = 1
        while k < 64 {
            let value = coef[zigzag_order[k].to(uint)]
            if value == 0 {
                run++
            } else {
                while run >= 16 {
                    this.write_code(ac, 0xf0)
                    run -= 16
                }
                this.write_value(ac, run, value)
                run = 0
            }
            k++
        }
        if run > 0 : this.write_code(ac, 0x00)
    }
}

fn scaled_quant(base: u8, scale: uint) u16 {
    let value = (base.to(uint) * scale + 50) / 100
    if value < 1 : return 1
    if value > 255 : return 255
    return value.to(u16)
}

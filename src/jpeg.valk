use valk.io
use valk.mem
use valk.math

// Baseline JPEG (ITU T.81 sequential DCT, Huffman coded, 8-bit samples): a decoder for
// gray and YCbCr/RGB images with any sampling factors and restart intervals, and an
// encoder writing gray or 4:2:0 / 4:4:4 YCbCr with the standard tables of Annex K.

// Natural-order index of each zigzag position
global zigzag_order: Array[u8] (Array[u8]{
    0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5,
    12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21, 28,
    35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51,
    58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63,
})

// The lookup table of the fastest Huffman path resolves codes up to this many bits
value FAST_BITS (9)

/// Whether `data` starts with the JPEG marker sequence.
+ fn is_jpeg(data: local &[u8]) bool {
    return data.length >= 3 && data[0] == 0xff && data[1] == 0xd8 && data[2] == 0xff
}

/// Decodes a JPEG image.
///
/// Reads baseline and progressive Huffman-coded 8-bit files with one component (gray) or
/// three (YCbCr, or RGB when an Adobe marker says so), any chroma sampling factors and
/// restart intervals. Subsampled chroma is upsampled bilinearly. Arithmetic-coded,
/// lossless, 12-bit and CMYK files throw `unsupported`; malformed files throw `invalid`.
+ fn decode_jpeg(data: local &[u8]) Image !ImageError {
    if !is_jpeg(data) : throw .invalid { message: "Not a JPEG file" }
    let bytes = [u8]{ 0 x data.length }
    mem.copy(data, bytes)
    let decoder = Decoder{ data: bytes }
    return decoder.decode() !>
}

extend Image {
    /// Encodes the image as a baseline JPEG at `quality` (1..100).
    ///
    /// Gray images are stored as one component, RGB and RGBA (alpha dropped) as YCbCr with
    /// 4:2:0 chroma subsampling, or 4:4:4 when `subsample_chroma` is false. Panics when a
    /// side exceeds 65535 pixels, the format's limit.
    + fn encode_jpeg(quality: uint (85), subsample_chroma: bool (true)) String {
        let out = ByteBuffer.new(this.pixels.length / 8 + 1024)
        this.encode_jpeg_into(out, quality, subsample_chroma) ! panic("A ByteBuffer write cannot fail")
        return out.into_string()
    }

    /// Writes the image as JPEG to `out` and returns the bytes written; see `encode_jpeg`.
    + fn encode_jpeg_into(out: io.Writer, quality: uint (85), subsample_chroma: bool (true)) uint !io.IoError {
        if this.width > 65535 || this.height > 65535 : panic("JPEG images are limited to 65535 pixels per side")
        let encoder = Encoder.new(this, quality, subsample_chroma)
        let buf = encoder.encode()
        return out.write(buf) !>
    }
}

// ---------------------------------------------------------------------------------------
// Decoder

class Huffman {
    // For codes of at most FAST_BITS bits: (length << 8) | symbol, 0 when longer
    fast: mut &[u16] ([u16]{ 0 x 512 })
    // Per code length 1..16: the largest code (-1 when none), the smallest, and the index
    // of the first symbol with that length
    maxcode: mut &[int] ([int]{ -1 x 18 })
    mincode: mut &[int] ([int]{ 0 x 18 })
    valptr: mut &[uint] ([uint]{ 0 x 18 })
    values: mut &[u8] ([u8]{ 0 x 256 })
    count: uint (0)

    static fn build(counts: local &[u8], values: local &[u8]) SELF !ImageError {
        let table = SELF{}
        let total: uint = 0
        let l: uint = 0
        while l < 16 : total += counts[l++].to(uint)
        if total > 256 || total > values.length : throw .invalid { message: "Huffman table has too many symbols" }
        mem.copy(values.view(0, total), table.values)
        table.count = total
        let code: int = 0
        let k: uint = 0
        l = 1
        while l <= 16 {
            let n = counts[l - 1].to(uint)
            table.mincode[l] = code
            table.valptr[l] = k
            let i: uint = 0
            while i < n {
                if l <= FAST_BITS {
                    let first = (code << (FAST_BITS - l)).to(uint)
                    let span: uint = 1 << (FAST_BITS - l)
                    let j: uint = 0
                    while j < span {
                        table.fast[first + j] = ((l << 8) | values[k].to(uint)).to(u16)
                        j++
                    }
                }
                code++
                k++
                i++
            }
            table.maxcode[l] = n > 0 ? code - 1 : -1
            if code > (1 << l) : throw .invalid { message: "Huffman table is over-subscribed" }
            code = code << 1
            l++
        }
        return table
    }
}

class Component {
    id: u8
    h: uint
    v: uint
    // Quantization table id; the Huffman table ids come from the scan header
    tq: u8
    td: u8 (0)
    ta: u8 (0)
    pred: int (0)
    // The decoded samples: `blocks_w` by `blocks_h` blocks (padded to whole MCUs), of
    // which the top-left `width` by `height` samples are the picture
    width: uint (0)
    height: uint (0)
    blocks_w: uint (0)
    blocks_h: uint (0)
    plane: mut &[u8] ([u8]{ 0 x 0 })
    // Progressive frames gather the coefficients of every block (natural order, 64 per
    // block) over several scans and transform them at the end
    coefs: mut &[int] ([int]{ 0 x 0 })

    get stride: uint {
        return this.blocks_w * 8
    }
}

class Decoder {
    data: mut &[u8]
    pos: uint (0)
    // Bit reader state for entropy-coded segments
    acc: uint (0)
    acc_bits: uint (0)
    // Tables by id
    quant: Array[?mut &[u16]] (.{ null, null, null, null })
    dc_tables: Array[?Huffman] (.{ null, null, null, null })
    ac_tables: Array[?Huffman] (.{ null, null, null, null })
    components: Array[Component] (.{})
    scan: Array[Component] (.{})
    width: uint (0)
    height: uint (0)
    hmax: uint (1)
    vmax: uint (1)
    mcus_x: uint (0)
    mcus_y: uint (0)
    restart_interval: uint (0)
    adobe_transform: int (-1)
    seen_frame: bool (false)
    progressive: bool (false)
    // The current scan: spectral band `ss..se` and the successive approximation bit
    // positions (`ah` previous, `al` this scan); `eobrun` counts blocks with no more
    // coefficients in the band
    ss: uint (0)
    se: uint (63)
    ah: uint (0)
    al: uint (0)
    eobrun: uint (0)
    coef: mut &[int] ([int]{ 0 x 64 })
    tmp: mut &[int] ([int]{ 0 x 64 })

    fn decode() Image !ImageError {
        this.pos = 2
        let seen_scan = false
        while true {
            let marker = this.next_marker() !>
            if marker == 0xd9 : break
            // Standalone markers carry no segment
            if marker == 0x01 || (marker >= 0xd0 && marker <= 0xd7) : continue
            if this.pos + 2 > this.data.length : throw .invalid { message: "Truncated segment" }
            let length = ((this.data[this.pos].to(uint) << 8) | this.data[this.pos + 1].to(uint))
            if length < 2 || this.pos + length > this.data.length : throw .invalid { message: "Truncated segment" }
            let segment = this.data.view(this.pos + 2, length - 2)
            this.pos += length
            if marker == 0xc0 || marker == 0xc1 || marker == 0xc2 {
                this.progressive = marker == 0xc2
                this.parse_frame(segment) !>
            } else if marker == 0xc3 || marker == 0xc7 || marker == 0xcb || marker == 0xcf {
                throw .unsupported { message: "Lossless JPEG" }
            } else if marker == 0xc5 || marker == 0xc6 || marker == 0xc9 || marker == 0xca || marker == 0xcd || marker == 0xce {
                throw .unsupported { message: "Arithmetic-coded or hierarchical JPEG" }
            } else if marker == 0xc4 {
                this.parse_huffman_tables(segment) !>
            } else if marker == 0xdb {
                this.parse_quant_tables(segment) !>
            } else if marker == 0xdd {
                if segment.length < 2 : throw .invalid { message: "Bad DRI segment" }
                this.restart_interval = (segment[0].to(uint) << 8) | segment[1].to(uint)
            } else if marker == 0xda {
                if !this.seen_frame : throw .invalid { message: "Scan before the frame header" }
                this.parse_scan(segment) !>
                this.decode_scan() !>
                seen_scan = true
            } else if marker == 0xee {
                if segment.length >= 12 && mem.equals(segment.view(0, 5), "Adobe") : this.adobe_transform = segment[11].to(int)
            }
            // APPn, COM, DNL and the rest are skipped
        }
        if !this.seen_frame : throw .invalid { message: "Missing frame header" }
        if !seen_scan : throw .invalid { message: "Missing scan" }
        return this.build_image() !>
    }

    // Advances to the next marker and returns its code
    fn next_marker() u8 !ImageError {
        let data = this.data
        while this.pos < data.length && data[this.pos] != 0xff : this.pos++
        while this.pos < data.length && data[this.pos] == 0xff : this.pos++
        if this.pos >= data.length : throw .invalid { message: "Missing end of image" }
        let marker = data[this.pos]
        this.pos++
        if marker == 0 : return this.next_marker() !>
        return marker
    }

    fn parse_frame(segment: local &[u8]) !ImageError {
        if this.seen_frame : throw .invalid { message: "Multiple frame headers" }
        if segment.length < 6 : throw .invalid { message: "Bad frame header" }
        if segment[0] != 8 : throw .unsupported { message: segment[0].to(uint).to(String) + "-bit samples" }
        this.height = (segment[1].to(uint) << 8) | segment[2].to(uint)
        this.width = (segment[3].to(uint) << 8) | segment[4].to(uint)
        let count = segment[5].to(uint)
        if this.height == 0 : throw .unsupported { message: "Height defined by a DNL marker" }
        if this.width == 0 || this.width * this.height > MAX_PIXELS : throw .too_large { message: "The image exceeds MAX_PIXELS" }
        if count == 4 : throw .unsupported { message: "CMYK JPEG" }
        if count != 1 && count != 3 : throw .unsupported { message: count.to(String) + "-component JPEG" }
        if segment.length < 6 + count * 3 : throw .invalid { message: "Bad frame header" }
        let i: uint = 0
        while i < count {
            let at = 6 + i * 3
            let h = (segment[at + 1] >> 4).to(uint)
            let v = (segment[at + 1] & 15).to(uint)
            if h == 0 || h > 4 || v == 0 || v > 4 : throw .invalid { message: "Bad sampling factors" }
            if segment[at + 2] > 3 : throw .invalid { message: "Bad quantization table id" }
            this.components.append(Component{ id: segment[at], h: h, v: v, tq: segment[at + 2] })
            if h > this.hmax : this.hmax = h
            if v > this.vmax : this.vmax = v
            i++
        }
        if count == 1 {
            // A single component is never subsampled, whatever the header says
            this.hmax = 1
            this.vmax = 1
            this.components[0].h = 1
            this.components[0].v = 1
        }
        this.mcus_x = (this.width + this.hmax * 8 - 1) / (this.hmax * 8)
        this.mcus_y = (this.height + this.vmax * 8 - 1) / (this.vmax * 8)
        each this.components as comp {
            comp.width = (this.width * comp.h + this.hmax - 1) / this.hmax
            comp.height = (this.height * comp.v + this.vmax - 1) / this.vmax
            comp.blocks_w = this.mcus_x * comp.h
            comp.blocks_h = this.mcus_y * comp.v
            comp.plane = [u8]{ 0 x comp.blocks_w * comp.blocks_h * 64 }
            if this.progressive : comp.coefs = [int]{ 0 x comp.blocks_w * comp.blocks_h * 64 }
        }
        this.seen_frame = true
    }

    fn parse_huffman_tables(segment: local &[u8]) !ImageError {
        let pos: uint = 0
        while pos < segment.length {
            if pos + 17 > segment.length : throw .invalid { message: "Bad Huffman table" }
            let class = segment[pos] >> 4
            let id = (segment[pos] & 15).to(uint)
            if class > 1 || id > 3 : throw .invalid { message: "Bad Huffman table id" }
            let counts = segment.view(pos + 1, 16)
            let total: uint = 0
            let i: uint = 0
            while i < 16 : total += counts[i++].to(uint)
            if pos + 17 + total > segment.length : throw .invalid { message: "Bad Huffman table" }
            let table = Huffman.build(counts, segment.view(pos + 17, total)) !>
            if class == 0 : this.dc_tables[id] = table
            else : this.ac_tables[id] = table
            pos += 17 + total
        }
    }

    fn parse_quant_tables(segment: local &[u8]) !ImageError {
        let pos: uint = 0
        while pos < segment.length {
            let precision = segment[pos] >> 4
            let id = (segment[pos] & 15).to(uint)
            if id > 3 : throw .invalid { message: "Bad quantization table id" }
            let size: uint = precision == 0 ? 64 : 128
            if pos + 1 + size > segment.length : throw .invalid { message: "Bad quantization table" }
            let table = [u16]{ 0 x 64 }
            let i: uint = 0
            while i < 64 {
                if precision == 0 : table[i] = segment[pos + 1 + i].to(u16)
                else : table[i] = ((segment[pos + 1 + i * 2].to(uint) << 8) | segment[pos + 2 + i * 2].to(uint)).to(u16)
                i++
            }
            this.quant[id] = table
            pos += 1 + size
        }
    }

    fn parse_scan(segment: local &[u8]) !ImageError {
        if segment.length < 1 : throw .invalid { message: "Bad scan header" }
        let count = segment[0].to(uint)
        if count == 0 || count > this.components.length || segment.length < 4 + count * 2 : throw .invalid { message: "Bad scan header" }
        this.scan = Array[Component]{}
        let i: uint = 0
        while i < count {
            let id = segment[1 + i * 2]
            let tables = segment[2 + i * 2]
            let found: ?Component = null
            each this.components as comp : if comp.id == id : found = comp
            if !isset(found) : throw .invalid { message: "Scan names an unknown component" }
            let comp = found
            comp.td = tables >> 4
            comp.ta = tables & 15
            if comp.td > 3 || comp.ta > 3 : throw .invalid { message: "Bad Huffman table id in scan" }
            if !isset(this.quant[comp.tq.to(uint)]) : throw .invalid { message: "Scan uses a missing quantization table" }
            comp.pred = 0
            this.scan.append(comp)
            i++
        }
        this.ss = segment[1 + count * 2].to(uint)
        this.se = segment[2 + count * 2].to(uint)
        this.ah = (segment[3 + count * 2] >> 4).to(uint)
        this.al = (segment[3 + count * 2] & 15).to(uint)
        this.eobrun = 0
        if this.progressive {
            // A DC scan covers coefficient 0 only and may interleave components; an AC
            // scan covers a band of one component. Refinements add one bit per scan.
            if this.se > 63 || this.ss > this.se : throw .invalid { message: "Bad spectral selection" }
            if this.ss == 0 && this.se != 0 : throw .invalid { message: "A DC scan cannot carry AC coefficients" }
            if this.ss > 0 && count != 1 : throw .invalid { message: "An AC scan must hold one component" }
            if this.al > 13 || (this.ah != 0 && this.ah != this.al + 1) : throw .invalid { message: "Bad successive approximation" }
        } else if this.ss != 0 || this.se != 63 || this.ah != 0 || this.al != 0 {
            throw .invalid { message: "Baseline scan with progressive parameters" }
        }
        each this.scan as comp {
            let needs_dc = this.ss == 0 && this.ah == 0
            let needs_ac = this.ss > 0 || !this.progressive
            if needs_dc && !isset(this.dc_tables[comp.td.to(uint)]) : throw .invalid { message: "Scan uses a missing Huffman table" }
            if needs_ac && !isset(this.ac_tables[comp.ta.to(uint)]) : throw .invalid { message: "Scan uses a missing Huffman table" }
        }
    }

    fn decode_scan() !ImageError {
        this.acc = 0
        this.acc_bits = 0
        let mcu_count: uint = 0
        if this.scan.length == 1 {
            // A single-component scan walks the component's own blocks, not padded MCUs
            let comp = this.scan[0]
            let bw = (comp.width + 7) / 8
            let bh = (comp.height + 7) / 8
            let by: uint = 0
            while by < bh {
                let bx: uint = 0
                while bx < bw {
                    this.decode_unit(comp, bx, by) !>
                    mcu_count++
                    if this.restart_interval > 0 && mcu_count % this.restart_interval == 0 && (by < bh - 1 || bx < bw - 1) : this.restart() !>
                    bx++
                }
                by++
            }
        } else {
            let total = this.mcus_x * this.mcus_y
            let my: uint = 0
            while my < this.mcus_y {
                let mx: uint = 0
                while mx < this.mcus_x {
                    each this.scan as comp {
                        let v: uint = 0
                        while v < comp.v {
                            let h: uint = 0
                            while h < comp.h {
                                this.decode_unit(comp, mx * comp.h + h, my * comp.v + v) !>
                                h++
                            }
                            v++
                        }
                    }
                    mcu_count++
                    if this.restart_interval > 0 && mcu_count % this.restart_interval == 0 && mcu_count < total : this.restart() !>
                    mx++
                }
                my++
            }
        }
        // Leave the position at the marker that ended the entropy-coded segment
        this.acc = 0
        this.acc_bits = 0
    }

    // Expects an RSTn marker: drops the buffered bits and resets the DC predictors
    fn restart() !ImageError {
        this.acc = 0
        this.acc_bits = 0
        let data = this.data
        while this.pos < data.length && data[this.pos] != 0xff : this.pos++
        while this.pos + 1 < data.length && data[this.pos] == 0xff && data[this.pos + 1] == 0xff : this.pos++
        if this.pos + 1 >= data.length || data[this.pos + 1] < 0xd0 || data[this.pos + 1] > 0xd7 : throw .invalid { message: "Missing restart marker" }
        this.pos += 2
        this.eobrun = 0
        each this.scan as comp : comp.pred = 0
    }

    fn decode_unit(comp: Component, bx: uint, by: uint) !ImageError {
        if bx >= comp.blocks_w || by >= comp.blocks_h : throw .invalid { message: "Block outside the component" }
        if this.progressive : this.decode_block_progressive(comp, bx, by) !>
        else : this.decode_block(comp, bx, by) !>
    }

    // Tops the accumulator up to at least 57 bits; past a marker it reads zeros
    fn fill() {
        let data = this.data
        while this.acc_bits <= 56 {
            let byte: uint = 0
            if this.pos < data.length {
                byte = data[this.pos].to(uint)
                if byte == 0xff {
                    if this.pos + 1 < data.length && data[this.pos + 1] == 0 : this.pos += 2
                    else : byte = 0
                } else {
                    this.pos++
                }
            }
            this.acc = (this.acc << 8) | byte
            this.acc_bits += 8
        }
    }

    fn read_bits(count: uint) uint {
        if count == 0 : return 0
        if this.acc_bits < count : this.fill()
        this.acc_bits -= count
        return (this.acc >> this.acc_bits) & ((1 << count) - 1)
    }

    fn decode_symbol(table: Huffman) u8 !ImageError {
        if this.acc_bits < 16 : this.fill()
        let peek = (this.acc >> (this.acc_bits - FAST_BITS)) & 511
        let entry = table.fast[peek].to(uint)
        if entry != 0 {
            this.acc_bits -= entry >> 8
            return (entry & 255).to(u8)
        }
        let code: int = 0
        let l: uint = 1
        while l <= 16 {
            code = (code << 1) | this.read_bits(1).to(int)
            if code <= table.maxcode[l] {
                let index = table.valptr[l] + (code - table.mincode[l]).to(uint)
                if index >= table.count : throw .invalid { message: "Bad Huffman code" }
                return table.values[index]
            }
            l++
        }
        throw .invalid { message: "Bad Huffman code" }
    }

    // Reads a `size`-bit magnitude category value as a signed coefficient
    fn receive_extend(size: uint) int {
        if size == 0 : return 0
        let value = this.read_bits(size).to(int)
        if value < (1 << (size - 1)) : value += ((-1) << size) + 1
        return value
    }

    // One block of a progressive scan: the band `ss..se` of its coefficients, either
    // their first `al`-shifted approximation or one more bit of precision
    fn decode_block_progressive(comp: Component, bx: uint, by: uint) !ImageError {
        let coefs = comp.coefs
        let base = (by * comp.blocks_w + bx) * 64
        if this.ss == 0 {
            if this.ah == 0 {
                let dc_table = this.dc_tables[comp.td.to(uint)]
                if !isset(dc_table) : throw .invalid { message: "Missing table" }
                let category = this.decode_symbol(dc_table) !>
                if category > 11 : throw .invalid { message: "Bad DC coefficient" }
                comp.pred += this.receive_extend(category.to(uint))
                coefs[base] = comp.pred << this.al
            } else if this.read_bits(1) == 1 {
                coefs[base] = coefs[base] | (1 << this.al)
            }
            return
        }
        let ac_table = this.ac_tables[comp.ta.to(uint)]
        if !isset(ac_table) : throw .invalid { message: "Missing table" }
        if this.ah == 0 {
            // First pass over the band: runs of zeros, values, and end-of-band runs that
            // skip whole blocks
            if this.eobrun > 0 {
                this.eobrun--
                return
            }
            let k = this.ss
            while k <= this.se {
                let symbol = this.decode_symbol(ac_table) !>
                let run = (symbol >> 4).to(uint)
                let size = (symbol & 15).to(uint)
                if size == 0 {
                    if run < 15 {
                        this.eobrun = (1 << run) + this.read_bits(run) - 1
                        break
                    }
                    k += 16
                    continue
                }
                k += run
                if k > 63 : throw .invalid { message: "Coefficients overflow the block" }
                coefs[base + zigzag_order[k].to(uint)] = this.receive_extend(size) << this.al
                k++
            }
            return
        }
        // Refinement: every coefficient already set gets a correction bit; the zero
        // positions in between count towards the run before a newly set coefficient
        let bit: int = 1 << this.al
        let k = this.ss
        if this.eobrun > 0 {
            this.eobrun--
            while k <= this.se {
                let at = base + zigzag_order[k].to(uint)
                if coefs[at] != 0 : this.refine(coefs, at, bit)
                k++
            }
            return
        }
        while k <= this.se {
            let symbol = this.decode_symbol(ac_table) !>
            let run = (symbol >> 4).to(uint)
            let size = (symbol & 15).to(uint)
            let value: int = 0
            let skip = run
            if size == 0 {
                if run < 15 {
                    this.eobrun = (1 << run) + this.read_bits(run) - 1
                    // The rest of this block is corrections only
                    skip = 64
                }
            } else {
                if size != 1 : throw .invalid { message: "Bad refinement code" }
                value = this.read_bits(1) == 1 ? bit : 0 - bit
            }
            while k <= this.se {
                let at = base + zigzag_order[k].to(uint)
                k++
                if coefs[at] != 0 {
                    this.refine(coefs, at, bit)
                } else if skip == 0 {
                    coefs[at] = value
                    break
                } else {
                    skip--
                }
            }
        }
    }

    // Adds one bit of precision to a coefficient that is already non-zero
    fn refine(coefs: local mut &[int], at: uint, bit: int) {
        if this.read_bits(1) == 0 : return
        let value = coefs[at]
        if (value & bit) != 0 : return
        coefs[at] = value > 0 ? value + bit : value - bit
    }

    // Dequantizes and transforms every block once all scans are in
    fn render_progressive() !ImageError {
        let coef = this.coef
        let natural_quant = [int]{ 0 x 64 }
        each this.components as comp {
            let quant = this.quant[comp.tq.to(uint)]
            if !isset(quant) : throw .invalid { message: "Missing quantization table" }
            let k: uint = 0
            while k < 64 {
                natural_quant[zigzag_order[k].to(uint)] = quant[k].to(int)
                k++
            }
            let coefs = comp.coefs
            let by: uint = 0
            while by < comp.blocks_h {
                let bx: uint = 0
                while bx < comp.blocks_w {
                    let base = (by * comp.blocks_w + bx) * 64
                    let i: uint = 0
                    while i < 64 {
                        coef[i] = coefs[base + i] * natural_quant[i]
                        i++
                    }
                    idct_block(coef, this.tmp, comp.plane, (by * 8) * comp.stride + bx * 8, comp.stride)
                    bx++
                }
                by++
            }
        }
    }

    fn decode_block(comp: Component, bx: uint, by: uint) !ImageError {
        let dc_table = this.dc_tables[comp.td.to(uint)]
        let ac_table = this.ac_tables[comp.ta.to(uint)]
        let quant = this.quant[comp.tq.to(uint)]
        if !isset(dc_table) || !isset(ac_table) || !isset(quant) : throw .invalid { message: "Missing table" }
        let coef = this.coef
        let i: uint = 0
        while i < 64 : coef[i++] = 0
        let category = this.decode_symbol(dc_table) !>
        if category > 11 : throw .invalid { message: "Bad DC coefficient" }
        comp.pred += this.receive_extend(category.to(uint))
        coef[0] = comp.pred * quant[0].to(int)
        let k: uint = 1
        while k < 64 {
            let symbol = this.decode_symbol(ac_table) !>
            let run = (symbol >> 4).to(uint)
            let size = (symbol & 15).to(uint)
            if size == 0 {
                if run != 15 : break
                k += 16
                continue
            }
            k += run
            if k > 63 : throw .invalid { message: "Coefficients overflow the block" }
            coef[zigzag_order[k].to(uint)] = this.receive_extend(size) * quant[k].to(int)
            k++
        }
        idct_block(coef, this.tmp, comp.plane, (by * 8) * comp.stride + bx * 8, comp.stride)
    }

    fn build_image() Image !ImageError {
        if this.progressive : this.render_progressive() !>
        let count = this.components.length
        let image = Image.new(this.width, this.height, count == 1 ? 1 : 3) !>
        if count == 1 {
            let comp = this.components[0]
            let y: uint = 0
            while y < this.height {
                mem.copy(comp.plane.view(y * comp.stride, this.width), image.row(y))
                y++
            }
            return image
        }
        let planes = Array[mut &[u8]]{}
        each this.components as comp : planes.append(this.upsample(comp))
        let c0 = planes[0]
        let c1 = planes[1]
        let c2 = planes[2]
        let rgb = this.adobe_transform == 0 || (this.components[0].id == 'R' && this.components[1].id == 'G' && this.components[2].id == 'B' && this.adobe_transform < 0)
        let pixels = image.pixels
        let total = this.width * this.height
        let i: uint = 0
        while i < total {
            let at = i * 3
            if rgb {
                pixels[at] = c0[i]
                pixels[at + 1] = c1[i]
                pixels[at + 2] = c2[i]
            } else {
                let y = c0[i].to(int) << 16
                let cb = c1[i].to(int) - 128
                let cr = c2[i].to(int) - 128
                pixels[at] = clamp_shift16(y + 91881 * cr)
                pixels[at + 1] = clamp_shift16(y - 22554 * cb - 46802 * cr)
                pixels[at + 2] = clamp_shift16(y + 116130 * cb)
            }
            i++
        }
        return image
    }

    // Returns the component at full resolution, `width * height` samples
    fn upsample(comp: Component) mut &[u8] {
        let width = this.width
        let height = this.height
        let out = [u8]{ 0 x width * height }
        if comp.h == this.hmax && comp.v == this.vmax {
            let y: uint = 0
            while y < height {
                mem.copy(comp.plane.view(y * comp.stride, width), out.view(y * width, width))
                y++
            }
            return out
        }
        // Bilinear: each output sample sits between the two nearest source samples per
        // axis, positions in 1/256ths, clamped at the picture edges
        let xs = sample_positions(width, comp.width, comp.h, this.hmax)
        let ys = sample_positions(height, comp.height, comp.v, this.vmax)
        let stride = comp.stride
        let plane = comp.plane
        let y: uint = 0
        while y < height {
            let y0 = ys[y * 2]
            let fy = ys[y * 2 + 1]
            let y1 = y0 + 1 < comp.height ? y0 + 1 : y0
            let row0 = y0 * stride
            let row1 = y1 * stride
            let x: uint = 0
            while x < width {
                let x0 = xs[x * 2]
                let fx = xs[x * 2 + 1]
                let x1 = x0 + 1 < comp.width ? x0 + 1 : x0
                let top = plane[row0 + x0].to(uint) * (256 - fx) + plane[row0 + x1].to(uint) * fx
                let bottom = plane[row1 + x0].to(uint) * (256 - fx) + plane[row1 + x1].to(uint) * fx
                out[y * width + x] = ((top * (256 - fy) + bottom * fy + 32768) >> 16).to(u8)
                x++
            }
            y++
        }
        return out
    }
}

// For each of `to` output positions: the source index and the 1/256ths past it, the
// source being `from` samples at `num / den` of the output resolution
fn sample_positions(to: uint, from: uint, num: uint, den: uint) mut &[uint] {
    let out = [uint]{ 0 x to * 2 }
    let i: uint = 0
    while i < to {
        // ((i + 0.5) * num / den - 0.5) * 256
        let pos: int = (((i * 2 + 1) * num * 128) / den).to(int) - 128
        if pos < 0 : pos = 0
        let index = (pos >> 8).to(uint)
        if index >= from {
            out[i * 2] = from - 1
            out[i * 2 + 1] = 0
        } else {
            out[i * 2] = index
            out[i * 2 + 1] = (pos & 255).to(uint)
        }
        i++
    }
    return out
}

fn clamp_shift16(value: int) u8 {
    let v = (value + 32768) >> 16
    if v < 0 : return 0
    if v > 255 : return 255
    return v.to(u8)
}

fn clamp_pixel(value: int) u8 {
    if value < 0 : return 0
    if value > 255 : return 255
    return value.to(u8)
}

// Fixed-point constants of the AAN-style integer IDCT (scaled by 4096)
value F_0_541 (2217)
value F_1_847 (7568)
value F_0_765 (3135)
value F_1_175 (4816)
value F_0_298 (1223)
value F_2_053 (8410)
value F_3_072 (12586)
value F_1_501 (6149)
value F_0_899 (3686)
value F_2_562 (10498)
value F_1_961 (8034)
value F_0_390 (1598)

// Inverse DCT of the 64 dequantized coefficients in `coef` (natural order) into 8x8
// samples at `out[offset]` with rows `stride` apart; `tmp` holds the column pass.
fn idct_block(coef: local &[int], tmp: local mut &[int], out: local mut &[u8], offset: uint, stride: uint) {
    let i: uint = 0
    while i < 8 {
        if coef[i + 8] == 0 && coef[i + 16] == 0 && coef[i + 24] == 0 && coef[i + 32] == 0 && coef[i + 40] == 0 && coef[i + 48] == 0 && coef[i + 56] == 0 {
            let dc = coef[i] * 4
            tmp[i] = dc
            tmp[i + 8] = dc
            tmp[i + 16] = dc
            tmp[i + 24] = dc
            tmp[i + 32] = dc
            tmp[i + 40] = dc
            tmp[i + 48] = dc
            tmp[i + 56] = dc
        } else {
            idct_1d(coef[i], coef[i + 8], coef[i + 16], coef[i + 24], coef[i + 32], coef[i + 40], coef[i + 48], coef[i + 56], tmp, i, 8, 512, 10, false, out, 0)
        }
        i++
    }
    i = 0
    while i < 8 {
        let base = i * 8
        idct_1d(tmp[base], tmp[base + 1], tmp[base + 2], tmp[base + 3], tmp[base + 4], tmp[base + 5], tmp[base + 6], tmp[base + 7], tmp, 0, 0, 65536 + (128 << 17), 17, true, out, offset + i * stride)
        i++
    }
}

// One 8-point IDCT; results go to `tmp[at + n * step]`, or clamped to `out[at_out + n]`
fn idct_1d(s0: int, s1: int, s2: int, s3: int, s4: int, s5: int, s6: int, s7: int, tmp: local mut &[int], at: uint, step: uint, bias: int, shift: uint, to_out: bool, out: local mut &[u8], at_out: uint) {
    let p2 = s2
    let p3 = s6
    let p1 = (p2 + p3) * F_0_541
    let t2 = p1 - p3 * F_1_847
    let t3 = p1 + p2 * F_0_765
    p2 = s0
    p3 = s4
    let t0 = (p2 + p3) * 4096
    let t1 = (p2 - p3) * 4096
    let x0 = t0 + t3 + bias
    let x3 = t0 - t3 + bias
    let x1 = t1 + t2 + bias
    let x2 = t1 - t2 + bias
    t0 = s7
    t1 = s5
    t2 = s3
    t3 = s1
    p3 = t0 + t2
    let p4 = t1 + t3
    p1 = t0 + t3
    p2 = t1 + t2
    let p5 = (p3 + p4) * F_1_175
    t0 = t0 * F_0_298
    t1 = t1 * F_2_053
    t2 = t2 * F_3_072
    t3 = t3 * F_1_501
    p1 = p5 - p1 * F_0_899
    p2 = p5 - p2 * F_2_562
    p3 = 0 - p3 * F_1_961
    p4 = 0 - p4 * F_0_390
    t3 += p1 + p4
    t2 += p2 + p3
    t1 += p2 + p4
    t0 += p1 + p3
    if to_out {
        out[at_out] = clamp_pixel((x0 + t3) >> shift)
        out[at_out + 7] = clamp_pixel((x0 - t3) >> shift)
        out[at_out + 1] = clamp_pixel((x1 + t2) >> shift)
        out[at_out + 6] = clamp_pixel((x1 - t2) >> shift)
        out[at_out + 2] = clamp_pixel((x2 + t1) >> shift)
        out[at_out + 5] = clamp_pixel((x2 - t1) >> shift)
        out[at_out + 3] = clamp_pixel((x3 + t0) >> shift)
        out[at_out + 4] = clamp_pixel((x3 - t0) >> shift)
    } else {
        tmp[at] = (x0 + t3) >> shift
        tmp[at + step * 7] = (x0 - t3) >> shift
        tmp[at + step] = (x1 + t2) >> shift
        tmp[at + step * 6] = (x1 - t2) >> shift
        tmp[at + step * 2] = (x2 + t1) >> shift
        tmp[at + step * 5] = (x2 - t1) >> shift
        tmp[at + step * 3] = (x3 + t0) >> shift
        tmp[at + step * 4] = (x3 - t0) >> shift
    }
}

// ---------------------------------------------------------------------------------------
// Encoder

global luma_quant: Array[u8] (Array[u8]{
    16, 11, 10, 16, 24, 40, 51, 61,
    12, 12, 14, 19, 26, 58, 60, 55,
    14, 13, 16, 24, 40, 57, 69, 56,
    14, 17, 22, 29, 51, 87, 80, 62,
    18, 22, 37, 56, 68, 109, 103, 77,

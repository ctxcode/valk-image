use valk.io

// Windows bitmaps: uncompressed 1, 4, 8, 16, 24 and 32-bit files with BITMAPINFOHEADER
// or later headers, bit-field masks included; the encoder writes 8-bit gray palettes,
// 24-bit RGB and 32-bit RGBA (V4 header with an alpha mask).

/// Whether `data` starts like a Windows bitmap.
+ fn is_bmp(data: local &[u8]) bool {
    return data.length >= 14 && data[0] == 'B' && data[1] == 'M'
}

/// Decodes a Windows bitmap.
///
/// Reads uncompressed 1, 4 and 8-bit palette, 16, 24 and 32-bit files, top-down or
/// bottom-up, with `BI_RGB` or `BI_BITFIELDS` layouts. Palette and 24-bit files become
/// RGB; 16 and 32-bit files become RGBA when they carry an alpha mask, or when a plain
/// 32-bit file has any non-zero alpha byte. Run-length or JPEG/PNG compressed files and
/// the OS/2 header throw `unsupported`.
+ fn decode_bmp(data: local &[u8]) Image !ImageError {
    if !is_bmp(data) : throw .invalid { message: "Not a BMP file" }
    let pixel_offset = read_u32_le(data, 10).to(uint)
    if data.length < 18 : throw .invalid { message: "Truncated BMP header" }
    let header_size = read_u32_le(data, 14).to(uint)
    if header_size < 40 : throw .unsupported { message: "OS/2 bitmap header" }
    if data.length < 14 + 40 || 14 + header_size > data.length : throw .invalid { message: "Truncated BMP header" }
    let width_raw = read_u32_le(data, 18).to(i32).to(int)
    let height_raw = read_u32_le(data, 22).to(i32).to(int)
    let bits = (data[28].to(uint) | (data[29].to(uint) << 8))
    let compression = read_u32_le(data, 30).to(uint)
    if width_raw <= 0 || height_raw == 0 : throw .invalid { message: "Empty bitmap" }
    let top_down = height_raw < 0
    let width = width_raw.to(uint)
    let height = (top_down ? 0 - height_raw : height_raw).to(uint)
    if width > MAX_PIXELS || height > MAX_PIXELS || width * height > MAX_PIXELS : throw .too_large { message: "The image exceeds MAX_PIXELS" }
    if compression == 1 || compression == 2 : throw .unsupported { message: "Run-length encoded bitmap" }
    if compression == 4 || compression == 5 : throw .unsupported { message: "JPEG or PNG inside a bitmap" }
    if compression != 0 && compression != 3 && compression != 6 : throw .invalid { message: "Unknown bitmap compression" }
    if bits != 1 && bits != 4 && bits != 8 && bits != 16 && bits != 24 && bits != 32 : throw .invalid { message: "Unknown bit depth" }

    // Channel masks: from the header for bit fields, else the fixed layouts
    let mask_r: uint = 0
    let mask_g: uint = 0
    let mask_b: uint = 0
    let mask_a: uint = 0
    if (compression == 3 || compression == 6) && bits >= 16 {
        let at: uint = 14 + 40
        if header_size >= 52 : at = 14 + 40
        if at + 12 > data.length : throw .invalid { message: "Missing bit-field masks" }
        mask_r = read_u32_le(data, at).to(uint)
        mask_g = read_u32_le(data, at + 4).to(uint)
        mask_b = read_u32_le(data, at + 8).to(uint)
        if header_size >= 56 && at + 16 <= data.length : mask_a = read_u32_le(data, at + 12).to(uint)
    } else if bits == 16 {
        mask_r = 0x7c00
        mask_g = 0x03e0
        mask_b = 0x001f
    } else if bits == 32 {
        mask_r = 0x00ff0000
        mask_g = 0x0000ff00
        mask_b = 0x000000ff
        mask_a = 0xff000000
    }

    // Palette: 4-byte BGRx entries after the header
    let palette_at = 14 + header_size
    let colors_used = read_u32_le(data, 46).to(uint)
    let palette_size: uint = 0
    if bits <= 8 {
        palette_size = colors_used == 0 ? (1 << bits) : colors_used
        if palette_at + palette_size * 4 > data.length : throw .invalid { message: "Truncated palette" }
    }

    let stride = ((width * bits + 31) / 32) * 4
    if pixel_offset < palette_at || pixel_offset + stride * height > data.length : throw .invalid { message: "Truncated pixel data" }

    // Plain 32-bit files usually leave the alpha byte at zero: treat them as opaque
    let has_alpha = mask_a != 0
    if bits == 32 && compression == 0 {
        has_alpha = false
        let y: uint = 0
        while y < height && !has_alpha {
            let row = pixel_offset + y * stride
            let x: uint = 0
            while x < width {
                if data[row + x * 4 + 3] != 0 {
                    has_alpha = true
                    break
                }
                x++
            }
            y++
        }
    }
    let channels: u8 = has_alpha ? 4 : 3
    let image = Image.new(width, height, channels) !>
    let c = channels.to(uint)
    let y: uint = 0
    while y < height {
        let row = pixel_offset + y * stride
        let dst = image.row(top_down ? y : height - 1 - y)
        let x: uint = 0
        while x < width {
            let at = x * c
            if bits <= 8 {
                let bit = x * bits
                let byte = data[row + bit / 8].to(uint)
                let index = bits == 8 ? byte : (byte >> (8 - bits - (bit % 8))) & ((1 << bits) - 1)
                if index >= palette_size : throw .invalid { message: "Pixel outside the palette" }
                let entry = palette_at + index * 4
                dst[at] = data[entry + 2]
                dst[at + 1] = data[entry + 1]
                dst[at + 2] = data[entry]
            } else if bits == 24 {
                let src = row + x * 3
                dst[at] = data[src + 2]
                dst[at + 1] = data[src + 1]
                dst[at + 2] = data[src]
            } else {
                let src = row + x * (bits / 8)
                let value = data[src].to(uint) | (data[src + 1].to(uint) << 8)
                if bits == 32 : value = value | (data[src + 2].to(uint) << 16) | (data[src + 3].to(uint) << 24)
                dst[at] = masked_channel(value, mask_r)
                dst[at + 1] = masked_channel(value, mask_g)
                dst[at + 2] = masked_channel(value, mask_b)
                if c == 4 : dst[at + 3] = masked_channel(value, mask_a)
            }
            x++
        }
        y++
    }
    return image
}

// Extracts the bits under `mask` and scales them to 0..255
fn masked_channel(value: uint, mask: uint) u8 {
    if mask == 0 : return 255
    let shift: uint = 0
    while (mask >> shift) & 1 == 0 : shift++
    let width: uint = 0
    while (mask >> (shift + width)) & 1 == 1 && shift + width < 32 : width++
    let raw = (value & mask) >> shift
    if width >= 8 : return (raw >> (width - 8)).to(u8)
    return (raw * 255 / ((1 << width) - 1)).to(u8)
}

fn read_u32_le(data: local &[u8], at: uint) u32 {
    return data[at].to(u32) | (data[at + 1].to(u32) << 8) | (data[at + 2].to(u32) << 16) | (data[at + 3].to(u32) << 24)
}

extend Image {
    /// Encodes the image as a Windows bitmap: 8-bit with a gray palette, 24-bit RGB, or
    /// 32-bit RGBA with a V4 header so readers know where the alpha is.
    + fn encode_bmp() String {
        let out = ByteBuffer.new(this.pixels.length + 1024 + 64)
        this.encode_bmp_into(out) ! panic("A ByteBuffer write cannot fail")
        return out.into_string()
    }

    /// Writes the image as a bitmap to `out` and returns the bytes written; see `encode_bmp`.
    + fn encode_bmp_into(out: io.Writer) uint !io.IoError {
        let c = this.channels.to(uint)
        let bits: uint = c == 1 ? 8 : (c == 3 ? 24 : 32)
        let header_size: uint = c == 4 ? 108 : 40
        let palette_size: uint = c == 1 ? 256 * 4 : 0
        let stride = ((this.width * bits + 31) / 32) * 4
        let pixel_offset = 14 + header_size + palette_size
        let total = pixel_offset + stride * this.height
        let buf = ByteBuffer.new(total)
        buf.write("BM")
        buf.write_u32_le(total.to(u32))
        buf.write_u32_le(0)
        buf.write_u32_le(pixel_offset.to(u32))
        buf.write_u32_le(header_size.to(u32))
        buf.write_u32_le(this.width.to(u32))
        buf.write_u32_le(this.height.to(u32))
        buf.write_u16_le(1)
        buf.write_u16_le(bits.to(u16))
        buf.write_u32_le(c == 4 ? 3 : 0)
        buf.write_u32_le((stride * this.height).to(u32))
        buf.write_u32_le(2835)
        buf.write_u32_le(2835)
        buf.write_u32_le(c == 1 ? 256 : 0)
        buf.write_u32_le(0)
        if c == 4 {
            buf.write_u32_le(0x00ff0000)
            buf.write_u32_le(0x0000ff00)
            buf.write_u32_le(0x000000ff)
            buf.write_u32_le(0xff000000)
            // sRGB color space, no endpoints or gamma, no intent
            buf.write("sRGB")
            let i: uint = 0
            while i < 12 {
                buf.write_u32_le(0)
                i++
            }
        }
        if c == 1 {
            let i: uint = 0
            while i < 256 {
                buf.write_byte(i.to(u8))
                buf.write_byte(i.to(u8))
                buf.write_byte(i.to(u8))
                buf.write_byte(0)
                i++
            }
        }
        let padding = stride - this.width * bits / 8
        let y = this.height
        while y > 0 {
            y--
            let row = this.row(y)
            if c == 1 {
                buf.write(row)
            } else {
                let x: uint = 0
                while x < this.width {
                    let at = x * c
                    buf.write_byte(row[at + 2])
                    buf.write_byte(row[at + 1])
                    buf.write_byte(row[at])
                    if c == 4 : buf.write_byte(row[at + 3])
                    x++
                }
            }
            let p: uint = 0
            while p < padding {
                buf.write_byte(0)
                p++
            }
        }
        return out.write(buf) !>
    }
}

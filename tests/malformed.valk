use image
use valk.compress

// Inputs found by fuzzing the decoders: each must end in an error or a picture, never a crash
// or a run over the whole of a huge declared size

fn splice(data: String, at: uint, bytes: String) String {
    let buf = ByteBuffer.new(data.bytes)
    buf.write(data)
    each bytes as b, i : buf.set(at + i, b)
    return buf.to_string()
}

test "Malformed: an over-subscribed JPEG Huffman table" {
    // The first DC table claims three 1-bit codes
    let data = asset("photo-420.jpg")
    let at = data.index_of("\xff\xc4") !!
    let bad = splice(data, at + 5, "\x03\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
    let failed = false
    image.decode_jpeg(bad) ! {
        assert(E.code == E.invalid && E.message.contains("over-subscribed"))
        failed = true
    }
    assert(failed)
}

test "Malformed: stuffed zero bytes after a JPEG scan" {
    // Each FF 00 pair used to cost a stack frame while looking for the next marker
    let data = asset("photo-420.jpg")
    let buf = ByteBuffer.new(data.bytes + 400000)
    buf.write(data.range(0, data.bytes - 2))
    let i: uint = 0
    while i < 200000 {
        buf.write("\xff\x00")
        i++
    }
    buf.write("\xff\xd9")
    let img = image.decode_jpeg(buf) !!
    assert(img.width == 37 && img.height == 29)
}

test "Malformed: JPEG scans after one that ran out of data are skipped" {
    // A scan cut short, then a scan header naming a component the frame does not have:
    // decoding it would cover the picture again with made-up zeros
    let data = asset("photo-420.jpg")
    let sos = data.index_of("\xff\xda") !!
    let header_end = sos + 2 + ((data[sos + 2].to(uint) << 8) | data[sos + 3].to(uint))
    let buf = ByteBuffer.new(data.bytes)
    buf.write(data.range(0, header_end + 20))
    buf.write("\xff\xda\x00\x08\x01\x09\x00\x00\x3f\x00")
    buf.write("\xff\xd9")
    let img = image.decode_jpeg(buf) !!
    assert(img.width == 37 && img.height == 29)
}

test "Malformed: GIF frames larger than the canvas count towards MAX_PIXELS" {
    // A 1x1 canvas and frames that each declare 65535x400 pixels, followed by a comment
    // long enough that the frames could hold that many
    let buf = ByteBuffer.new(4096)
    buf.write("GIF89a\x01\x00\x01\x00\x80\x00\x00\x00\x00\x00\xff\xff\xff")
    let i: uint = 0
    while i < 3 {
        buf.write("\x2c\x00\x00\x00\x00\xff\xff\x90\x01\x00\x02\x02\x44\x01\x00")
        i++
    }
    buf.write("\x21\xfe")
    i = 0
    while i < 10 {
        buf.write_byte(255)
        let k: uint = 0
        while k < 255 {
            buf.write_byte('x')
            k++
        }
        i++
    }
    buf.write_byte(0)
    buf.write("\x3b")
    let first = image.decode_gif(buf) !!
    assert(first.width == 1 && first.height == 1)
    let failed = false
    image.decode_gif_animation(buf) ! {
        assert(E.code == E.too_large)
        failed = true
    }
    assert(failed)
}

test "Malformed: a huge PNG with almost no data" {
    // 8192x8192 RGBA at 16 bits with a few bytes of image data
    let png = image.Image.new(1, 1, 4) !!
    let data = png.encode_png()
    let at = data.index_of("IHDR") !!
    let bad = splice(data, at + 4, "\x00\x00\x20\x00\x00\x00\x20\x00\x10")
    let crc = ByteBuffer.new(4)
    crc.write_u32_be(compress.crc32(bad.range(at, 17)))
    bad = splice(bad, at + 17, crc.to_string())
    let failed = false
    image.decode_png(bad) ! {
        assert(E.code == E.invalid && E.message.contains("wrong size"))
        failed = true
    }
    assert(failed)
}

test "Malformed: a JPEG declaring far more MCUs than its data can hold" {
    // 8000x8000 with about 1 KB of data
    let data = asset("photo-420.jpg")
    let at = data.index_of("\xff\xc0") !!
    let bad = splice(data, at + 5, "\x1f\x40\x1f\x40")
    let failed = false
    image.decode_jpeg(bad) ! {
        assert(E.code == E.invalid && E.message.contains("too short"))
        failed = true
    }
    assert(failed)
}

test "Malformed: a GIF frame declaring far more pixels than its data can hold" {
    let buf = ByteBuffer.new(64)
    buf.write("GIF89a\xff\xff\x00\x04\x80\x00\x00\x00\x00\x00\xff\xff\xff")
    buf.write("\x2c\x00\x00\x00\x00\xff\xff\x00\x04\x00\x02\x02\x44\x01\x00\x3b")
    let failed = false
    image.decode_gif(buf) ! {
        assert(E.code == E.invalid && E.message.contains("too short"))
        failed = true
    }
    assert(failed)
}

test "Malformed: a lossy WebP declaring far more macroblocks than its data holds" {
    // 8000x8000 with the data of a small picture: fails at the first row past the data
    let data = asset("webp-lossy-rgb.webp")
    let at = data.index_of("VP8 ") !!
    let bad = splice(data, at + 14, "\x40\x1f\x40\x1f")
    let failed = false
    image.decode_webp(bad) ! {
        assert(E.code == E.invalid && E.message.contains("ends early"))
        failed = true
    }
    assert(failed)
}

test "Malformed: a lossless WebP cut short with its sizes fixed up" {
    // Noise does not compress, so the first half of the data holds about half the pixels
    let img = image.Image.new(64, 64, 3) !!
    let seed: uint = 7
    each img.pixels as _, i {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        img.pixels[i] = (seed >> 16).to(u8)
    }
    let data = img.encode_webp_lossless() !!
    let cut = data.bytes / 2
    let size = ByteBuffer.new(4)
    size.write_u32_le((cut - 8).to(u32))
    let bad = splice(data.range(0, cut), 4, size.to_string())
    size.clear()
    size.write_u32_le((cut - 20).to(u32))
    bad = splice(bad, 16, size.to_string())
    let failed = false
    image.decode_webp(bad) ! {
        assert(E.code == E.invalid && E.message.contains("ends early"))
        failed = true
    }
    assert(failed)
}

// Writes bits least significant first, as VP8L reads them
class BitWriter {
    out: ByteBuffer (ByteBuffer.new(1024))
    acc: uint (0)
    count: uint (0)

    fn write(value: uint, bits: uint) {
        let i: uint = 0
        while i < bits {
            this.acc = this.acc | (((value >> i) & 1) << this.count)
            this.count++
            if this.count == 8 {
                this.out.write_byte(this.acc.to(u8))
                this.acc = 0
                this.count = 0
            }
            i++
        }
    }
    // A Huffman code of one 8-bit symbol, which then takes no bits per pixel
    fn single(symbol: uint) {
        this.write(1, 1)
        this.write(0, 1)
        this.write(1, 1)
        this.write(symbol, 8)
    }
}

test "Malformed: a lossless WebP naming entropy group 65535" {
    // 4x4 pixels whose meta image picks group 65535: all 65536 groups are in the data, only
    // the last is used and must be the one applied
    let w = BitWriter{}
    w.write(0x2f, 8)
    w.write(3, 14)
    w.write(3, 14)
    w.write(0, 4)
    w.write(0, 1) // no transforms
    w.write(0, 1) // no colour cache
    w.write(1, 1) // meta image, 4x4 blocks
    w.write(0, 3)
    w.write(0, 1)
    w.single(0xff) // green and red of the meta pixel: group 0xffff
    w.single(0xff)
    w.single(0)
    w.single(0)
    w.single(0)
    let g: uint = 0
    while g < 65536 {
        // green, red, blue, alpha, distance
        w.single(g == 65535 ? 0x80 : 0x10)
        w.single(g == 65535 ? 0x40 : 0x10)
        w.single(0x20)
        w.single(0xff)
        w.single(0)
        g++
    }
    w.write(0, 8)
    let chunk = w.out.to_string()
    let file = ByteBuffer.new(chunk.bytes + 32)
    file.write("RIFF")
    file.write_u32_le((chunk.bytes + 12).to(u32))
    file.write("WEBPVP8L")
    file.write_u32_le(chunk.bytes.to(u32))
    file.write(chunk)
    let img = image.decode_webp(file) !!
    assert(img.width == 4 && img.height == 4 && img.channels == 3)
    assert(img.get(3, 3, 0) == 0x40 && img.get(3, 3, 1) == 0x80 && img.get(3, 3, 2) == 0x20)
}

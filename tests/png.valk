use image
use valk.mem

fn asset(name: String) String {
    let files = #embed_dir("assets")
    return files.get(name) !? ""
}

test "PNG: RGBA with every row filter decodes to the expected pixels" {
    let img = image.decode(asset("rgba-filters.png")) !!
    assert(img.width == 4 && img.height == 3 && img.channels == 4)
    let y: uint = 0
    while y < 3 {
        let x: uint = 0
        while x < 4 {
            assert(img.get(x, y, 0) == (x * 60).to(u8))
            assert(img.get(x, y, 1) == (y * 100).to(u8))
            assert(img.get(x, y, 2) == ((x + y) * 30).to(u8))
            assert(img.get(x, y, 3) == (255 - x * 40).to(u8))
            x++
        }
        y++
    }
}

test "PNG: RGB, gray, 1-bit, palette, gray+alpha, 16-bit and tRNS" {
    let rgb = image.decode_png(asset("rgb.png")) !!
    assert(rgb.channels == 3 && rgb.get(3, 2, 0) == 180 && rgb.get(3, 2, 2) == 150)

    let gray = image.decode_png(asset("gray.png")) !!
    assert(gray.channels == 1 && gray.get(2, 1) == 110)

    let bits = image.decode_png(asset("gray1.png")) !!
    assert(bits.width == 8 && bits.channels == 1)
    let expect = Array[u8]{ 255, 0, 255, 255, 0, 0, 255, 0 }
    each expect as v, i : assert(bits.get(i, 0) == v)

    let pal = image.decode_png(asset("palette.png")) !!
    assert(pal.channels == 4 && pal.width == 4)
    assert(pal.get(0, 0, 0) == 255 && pal.get(0, 0, 3) == 255) // red, opaque
    assert(pal.get(1, 0, 1) == 255 && pal.get(1, 0, 3) == 0)   // green, transparent
    assert(pal.get(2, 0, 2) == 255 && pal.get(3, 0, 0) == 255)

    let ga = image.decode_png(asset("gray-alpha.png")) !!
    assert(ga.channels == 4)
    assert(ga.get(0, 0, 0) == 10 && ga.get(0, 0, 2) == 10 && ga.get(0, 0, 3) == 255)
    assert(ga.get(1, 0, 0) == 200 && ga.get(1, 0, 3) == 0)

    let deep = image.decode_png(asset("rgb16.png")) !!
    assert(deep.channels == 3 && deep.get(0, 0, 0) == 0x12 && deep.get(0, 0, 1) == 0x56 && deep.get(0, 0, 2) == 0x9a)

    let keyed = image.decode_png(asset("gray-trns.png")) !!
    assert(keyed.channels == 4)
    assert(keyed.get(0, 0, 3) == 0 && keyed.get(1, 0, 3) == 255 && keyed.get(2, 0, 3) == 0)
}

test "PNG: malformed and unsupported files are reported" {
    image.decode_png(asset("interlaced.png")) ! {
        assert(E.code == E.unsupported)
        assert(E.message.contains("Adam7"))
    }
    image.decode_png(asset("bad-crc.png")) ! {
        assert(E.code == E.invalid)
        assert(E.message.contains("CRC"))
    }
    image.decode("not an image") ! {
        assert(E.code == E.invalid)
    }
    image.decode("\xff\xd8\xff\xe0") ! {
        assert(E.code == E.unsupported)
        assert(E.message == "JPEG")
    }
    image.decode_png("\x89PNG\r\n\x1a\n") ! {
        assert(E.code == E.invalid)
    }
}

test "PNG: encoding round-trips every channel count" {
    let channels = Array[u8]{ 1, 3, 4 }
    each channels as c {
        let img = image.Image.new(5, 4, c) !!
        let y: uint = 0
        while y < 4 {
            let x: uint = 0
            while x < 5 {
                let k: uint = 0
                while k < c.to(uint) {
                    img.set(x, y, ((x * 37 + y * 91 + k * 13) % 256).to(u8), k.to(u8))
                    k++
                }
                x++
            }
            y++
        }
        let encoded = img.encode_png()
        assert(image.is_png(encoded))
        let back = image.decode(encoded) !!
        assert(back.width == 5 && back.height == 4 && back.channels == c)
        assert(mem.equals(back.pixels, img.pixels))
    }
}

use image

// Makes a 300x200 thumbnail: `valk build . --run -- photo.jpg thumb.jpg`
// The formats follow the file extensions: .png, .jpg/.jpeg or .bmp
fn main(args: Array[String]) {
    let from = args.get(1) !? "photo.jpg"
    let to = args.get(2) !? "thumb.jpg"
    let photo = image.read(from) ! panic("Cannot read " + from + ": " + E.message)
    let thumb = photo.cover(300, 200) ! panic("Cannot resize: " + E.message)
    thumb.write(to) ! panic("Cannot write " + to + ": " + E.message)
    println("Wrote " + to + " (" + thumb.width + "x" + thumb.height + ")")
}
